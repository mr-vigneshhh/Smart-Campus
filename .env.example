# CampuSphere Environment Variables Template
# Copy this file to .env to configure custom API keys.
# CampuSphere automatically operates with fully featured mock & offline fallback services
# if these keys are not set, ensuring 100% functionality and security during evaluation.

# Google Gemini API Key (Optional: for live generative AI campus concierge queries)
# Get a free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Google Maps JavaScript API Key (Optional: for embedded dynamic satellite maps)
# Get a key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_KEY=

# Campus Default Coordinates (Latitude, Longitude)
VITE_CAMPUS_LAT=37.4275
VITE_CAMPUS_LNG=-122.1697
VITE_CAMPUS_NAME=Horizon University Campus
